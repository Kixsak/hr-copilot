# Copy to .env for local Docker Compose use. Never commit .env.
ANTHROPIC_API_KEY=
# claude-haiku-5-5 (default, cheapest) / claude-sonnet-5-5 / claude-opus-5-5
CLAUDE_MODEL=claude-haiku-5-5
# Optional: use Claude on Microsoft Foundry instead of the Anthropic API.
# Setting the resource name switches the backend; CLAUDE_MODEL must then match your deployment name.
ANTHROPIC_FOUNDRY_RESOURCE=
ANTHROPIC_FOUNDRY_API_KEY=
HRC_BOOTSTRAP_PASSWORD=
HRC_PORT=8501
HRC_HOST_DATA_DIR=./data
